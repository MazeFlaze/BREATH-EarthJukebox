# BREATHE – Root Environment Overview
# The project is structured into independent frontend and backend workspaces.
# Copy individual environment templates as needed:
# - Frontend: cp frontend/.env.example frontend/.env.local
# - Backend:  cp backend/.env.example backend/.env

# Global Project Settings
PROJECT_NAME="BREATHE - The Earth Information Jukebox"
CHALLENGE="NASA Space Apps Challenge 2026"

# Service URLs
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Runtime upstream target for Next.js API proxy (/api/v1/[...path])
BACKEND_API_URL="http://localhost:8000"
# Optional build-time explicit browser endpoint (leave unset to use same-origin Next.js proxy)
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"
# Comma-separated or JSON list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# NASA Earthdata / GIBS APIs (Workstream N01)
NASA_GIBS_ENDPOINT="https://gibs.earthdata.nasa.gov/wmts/epsg4326/best"
NASA_CMR_API_URL="https://cmr.earthdata.nasa.gov/search/granules.json"
