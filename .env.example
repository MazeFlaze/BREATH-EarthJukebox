# BREATHE – Environment Variables
# Copy this file to .env.local for local overrides.
# Never commit real credentials or .env.local to git.

# Application Environment
NEXT_PUBLIC_APP_NAME="BREATHE - Earth Information Jukebox"
NEXT_PUBLIC_APP_ENV="development"

# Data Provider Configuration
# Set to true during hackathon prototyping when local mock data is used
NEXT_PUBLIC_ENABLE_MOCK_DATA="true"

# NASA Earthdata / GIBS API (Optional for N01 data engineering integration)
# https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USERNAME=""
NASA_EARTHDATA_PASSWORD=""
NEXT_PUBLIC_NASA_GIBS_ENDPOINT="https://gibs.earthdata.nasa.gov/wmts/epsg4326/best"

# Web Audio Configuration (For N03 sonification)
NEXT_PUBLIC_AUDIO_DEFAULT_VOLUME="0.7"
