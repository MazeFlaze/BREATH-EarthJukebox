# BREATHE Backend - Environment Configuration
# Copy this file to .env for local development. Never commit .env to git.

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Optional dedicated manual-download archive (default: backend/src/data/nasa-archive).
# Use an absolute path when overriding. The CLI also accepts --archive-dir.
# NASA_ARCHIVE_ROOT=D:/NASA/geos-cf-archive

# CORS Settings (Allow Next.js frontend)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# NASA Earthdata API Credentials (Optional - for direct CMR / GIBS ingestion)
# Register at: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USERNAME=""
NASA_EARTHDATA_PASSWORD=""
NASA_CMR_API_URL="https://cmr.earthdata.nasa.gov/search/granules.json"
NASA_GIBS_ENDPOINT="https://gibs.earthdata.nasa.gov/wmts/epsg4326/best"
